# ============================================================
# ARO AI — .gitignore
# ============================================================

# Dart/Flutter/Pub
.dart_tool/
.packages
.pub/
.pub-cache/
build/

# IDE
.idea/
.vscode/
*.iml

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/App.framework
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/.last_build_id

# Android — signing material must NEVER be committed
*.jks
**/key.properties
**/*-base64.txt
**/local.properties


# Mac
.DS_Store

# Logs
*.log

# Env / secrets
.env
.env.*
**/secrets/**
**/*.keystore

# Supabase local dev (if you use supabase cli later)
supabase/.temp/
supabase/.env
node_modules/
apps/web/node_modules/
apps/web/.next/

# Python / training
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
training/outputs/
training/data/*.jsonl
*.safetensors
*.gguf
service-account*.json
firestore/node_modules/
firestore-debug.log
training/live_server.pid
training/*.log
