# Supabase Edge Function secrets for ARO AI.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
# (copy this file to .env first — .env is git-ignored; never commit real values)

# Firebase project whose ID tokens the functions accept.
FIREBASE_PROJECT_ID=corebridge-ai

# --- ARO 1.5 (ARO AI's own model) --------------------------------------
# OpenAI-compatible base URL of the ARO model server (vLLM), ending in /v1.
# From Colab: the trycloudflare URL the notebook prints. From a GPU server:
# its HTTPS address.
ARO_MODEL_BASE_URL=https://example.trycloudflare.com/v1
# Same value as ARO_MODEL_API_KEY on the model server.
ARO_MODEL_API_KEY=replace-with-a-long-random-string
ARO_MODEL_NAME=aro-1.5

# Backup used while the ARO server is offline (any OpenAI-compatible API,
# billed to ARO AI). Answers from it are labelled in the app and are never
# used for training. Leave empty to show "ARO is offline" instead.
ARO_FALLBACK_BASE_URL=
ARO_FALLBACK_API_KEY=
ARO_FALLBACK_MODEL=

# --- GitHub coding agent (optional) -----------------------------------
# Time one agent request may run before pausing (Edge Functions stop at 150 s).
AGENT_TIME_BUDGET_MS=110000

# --- File processing (existing) ---------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.
