# Supabase Edge Function secrets for ARO AI.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
# (copy this file to .env first — .env is git-ignored; never commit real values)

# Firebase project whose ID tokens the functions accept.
FIREBASE_PROJECT_ID=corebridge-ai

# --- ARO 1.5 (ARO AI's own model) --------------------------------------
# OpenAI-compatible base URL of the ARO model server (vLLM), ending in /v1.
# Production: the RunPod Serverless endpoint (scales to zero, see docs/COSTS.md):
#   https://api.runpod.ai/v2/<endpoint id>/openai/v1
# Testing from Colab or a pod: the HTTPS URL it prints.
ARO_MODEL_BASE_URL=https://api.runpod.ai/v2/<endpoint-id>/openai/v1
# Serverless: a RunPod API key restricted to that endpoint. A pod or Colab:
# the key the server was started with.
ARO_MODEL_API_KEY=replace-me
# ARO's context window in tokens; must equal the server's MAX_MODEL_LEN.
ARO_CONTEXT_TOKENS=32768

# Backup used while the ARO server is offline (any OpenAI-compatible API,
# billed to ARO AI). Answers from it are labelled in the app and are never
# used for training. Leave empty to show "ARO is offline" instead.
ARO_FALLBACK_BASE_URL=
ARO_FALLBACK_API_KEY=
ARO_FALLBACK_MODEL=

# ARO Vision runs on its own vision-language server (vLLM, Qwen3-VL). Leave
# empty until it exists; keep the model 'planned' in the admin dashboard.
ARO_VISION_BASE_URL=
ARO_VISION_API_KEY=

# --- Plans, entitlements, admin -----------------------------------------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically and
# are required: every ARO request is checked against the user's plan.
# Firebase UIDs (comma-separated) allowed to use the admin dashboard.
ADMIN_UIDS=

# --- Cost controls (docs/COSTS.md) ---------------------------------------
# Budgets, rates and limits live in Postgres and are edited in the admin
# dashboard. Budget alerts (50/80/100% of the daily GPU budget) are POSTed
# here — a Slack or Discord incoming-webhook URL. Optional.
ARO_ALERT_WEBHOOK_URL=

# --- GitHub coding agent (optional) -----------------------------------
# Time one agent request may run before pausing (Edge Functions stop at 150 s).
AGENT_TIME_BUDGET_MS=110000

# --- File processing (existing) ---------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
